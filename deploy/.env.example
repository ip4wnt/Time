# Скопировать в корень проекта как .env (или указать путь через CHRONUM_ENV)

# Подключение к PostgreSQL
DATABASE_URL=postgres://chronum:СМЕНИТЬ_ПАРОЛЬ@127.0.0.1:5432/chronum

# Порт приложения (nginx проксирует на него)
PORT=3000
HOST=127.0.0.1

# Куда складывать файлы, фото и аудио (каталог должен быть доступен на запись)
UPLOAD_DIR=/var/lib/chronum/uploads

# Максимальный размер одного файла, МБ
MAX_UPLOAD_MB=50

# Срок жизни сессии, дней
SESSION_DAYS=30

# За nginx с HTTPS — оставить 1. Для локальной разработки по http — 0
SECURE_COOKIES=1
TRUST_PROXY=1
